# Copy this file to .env.observer. DO NOT COMMIT .env.observer.
# These values are intentionally blank. Do not reuse credentials copied from old public projects.

# Tapo API read-only health probe (optional)
TAPO_USER=tapolab
TAPO_PASSWORD=tapolab

# RTSP probe (optional). Either set TAPO_RTSP_URL directly OR the 3 fields below.
TAPO_RTSP_URL=
TAPO_RTSP_USER=
TAPO_RTSP_PASSWORD=
TAPO_RTSP_PATH=/stream2
